@page "/occupancy"
@using System.Globalization
@using Domain.Entities
@using Application.Interfaces
@attribute [AllowAnonymous]

@inject IRoomRepository RoomRepository
@inject IReservationRepository ReservationRepository

<h2 class="text-2xl font-bold mb-4">Aktuální obsazenost</h2>

<label>Vyber datum:</label>
<input type="date" @bind="SelectedDate" @bind:format="yyyy-MM-dd" class="border p-2 mb-4" />

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

@if (Rooms is null)
{
    <p>Načítám místnosti…</p>
}
else if (!Rooms.Any())
{
    <p>Žádné místnosti k dispozici.</p>
}
else
{
    @foreach (var room in Rooms)
    {
        <h3 class="text-xl font-semibold mt-6">@room.Name</h3>
        <div class="room-container">
            @foreach (var seat in (room.Seats ?? Enumerable.Empty<Seat>()))
            {
                var occupied = IsSeatOccupied(seat, SelectedDate);

                <span @key="seat.Id"
                      class="@GetSeatCss(occupied)"
                      title="@GetSeatTitle(seat, occupied)">
                    @seat.Code
                </span>
            }
        </div>
    }
}

@code {
    List<Room>? Rooms;
    List<Reservation> Reservations = new();

    string? ErrorMessage;

    private DateTime _selectedDate = DateTime.Today;
    DateTime SelectedDate
    {
        get => _selectedDate;
        set
        {
            var newDate = value.Date;
            if (_selectedDate == newDate) return;

            _selectedDate = newDate;
            ErrorMessage = null;

            _ = InvokeAsync(async () =>
            {
                try
                {
                    Reservations = await ReservationRepository.GetByDateAsync(_selectedDate);
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Načtení rezervací selhalo: {ex}");
                    ErrorMessage = "Načtení rezervací selhalo.";
                }
            });
        }
    }

    private bool IsSeatOccupied(Seat seat, DateTime date)
    {
        return Reservations.Any(r =>
            r.SeatId == seat.Id &&
            r.BookDate.ToDateTime(TimeOnly.MinValue).Date == date.Date);
    }

    private string GetSeatCss(bool isOccupied)
    {
        if (isOccupied) return "seat-occupied ro";
        return "seat-free ro";
    }

    private string GetSeatTitle(Seat seat, bool occupied)
    {
        if (!occupied) return "Volné místo";

        var d = DateOnly.FromDateTime(SelectedDate);
        var res = Reservations.FirstOrDefault(r => r.SeatId == seat.Id && r.BookDate == d);
        if (res is null) return "Obsazeno";

        var displayName = res.User?.DisplayName;
        var who = !string.IsNullOrWhiteSpace(displayName)
            ? displayName
            : (!string.IsNullOrWhiteSpace(res.User?.Email) ? res.User!.Email! : res.UserId);

        var createdLocal = res.CreateDate.ToLocalTime();
        var createdStr = createdLocal.ToString("dd.MM.yyyy HH:mm", CultureInfo.CurrentCulture);

        return $"Obsazeno: {who} (rezervováno {createdStr})";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Rooms = await RoomRepository.GetAllWithSeatsAsync();
            Reservations = await ReservationRepository.GetByDateAsync(SelectedDate);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Inicializace selhala: {ex}");
            ErrorMessage = "Načtení dat selhalo.";
        }
    }
}

<style>
    .room-container {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .seat-free.ro {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-700) 100%);
        padding: 10px 20px;
        border-radius: 6px;
        border: 1px solid var(--color-primary-900);
        cursor: default;
        user-select: none;
        color: #0d1a10;
    }

    .seat-occupied.ro {
        background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-700) 100%);
        padding: 10px 20px;
        border-radius: 6px;
        border: 1px solid var(--color-accent-900);
        cursor: default;
        user-select: none;
        color: #ffffff;
    }
</style>