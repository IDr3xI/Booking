@page "/login"

<h2>Přihlášení</h2>

<div class="stack">
    <label class="label" for="email">E-mail</label>
    <input id="email" class="input" @bind="email" type="email" />

    <label class="label" for="password">Heslo</label>
    <input id="password" class="input" @bind="password" type="password" />

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SignIn">Přihlásit</button>
        <button class="btn btn-accent mt-2" @onclick="GoHome">Zpět</button>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;

    private async Task SignIn()
    {
        var uri = $"/auth/signin?email={Uri.EscapeDataString(email)}&password={Uri.EscapeDataString(password)}";
        Navigation.NavigateTo(uri, forceLoad: true);
    }

    [Inject] NavigationManager Navigation { get; set; } = default!;
    private void GoHome() => Navigation.NavigateTo("/");
}

