@page "/reservation"
@using System.Globalization

@using Domain.Entities
@using Application.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject IReservationRepository ReservationRepository
@inject ISeatRepository SeatRepository
@inject IRoomRepository RoomRepository
@inject AuthenticationStateProvider AuthenticationStateProvider

@attribute [Authorize]

<h2 class="text-2xl font-bold mb-4">Rezervace místnosti</h2>

<label>Vyber datum:</label>
<input type="date" @bind="SelectedDate" @bind:format="yyyy-MM-dd" class="border p-2 mb-4" />

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

@if (Rooms is null)
{
    <p>Načítám místnosti…</p>
}
else if (!Rooms.Any())
{
    <p>Žádné místnosti k dispozici.</p>
}
else
{
    @foreach (var room in Rooms)
    {
        <h3 class="text-xl font-semibold mt-6">@room.Name</h3>
        <div class="room-container">
            @foreach (var seat in (room.Seats ?? Enumerable.Empty<Seat>()))
            {
                var occupied = IsSeatOccupied(seat, SelectedDate);
                var canCancelOwn = occupied && IsOccupiedByCurrentUser(seat, SelectedDate);
                var isPast = SelectedDate.Date < DateTime.Today;

                <button @key="seat.Id"
                        type="button"
                        class="@GetSeatCss(seat)"
                        disabled="@(occupied && !(canCancelOwn && !isPast))"
                        aria-disabled="@(occupied && !(canCancelOwn && !isPast))"
                        title="@GetSeatTitle(seat, occupied, canCancelOwn, isPast)"
                        @onclick="() => OnSeatClick(seat)">
                    @seat.Code
                </button>
            }
        </div>
    }

    @if (SelectedSeat is not null)
    {
        var isPast = SelectedDate.Date < DateTime.Today;
        <div class="mt-4 p-4 bg-light border rounded shadow-sm">
            <div>Vybráno: @SelectedSeat.Code</div>

            <h4>Chcete rezervovat místo?</h4>

            <p>
                <strong>Místnost:</strong> @SelectedSeat.Room?.Name<br />
                <strong>Místo:</strong> @SelectedSeat.Code<br />
                <strong>Datum:</strong> @SelectedDate.ToShortDateString()
            </p>

            @if (isPast)
            {
                <div class="alert alert-info" role="alert">
                    Nelze rezervovat zpětně. Vyberte dnešní nebo budoucí datum.
                </div>
            }

            <div class="mt-2">
                <button type="button" class="btn btn-primary"
                        disabled="@isPast"
                        title="@(isPast ? "Nelze rezervovat zpětně" : "Potvrdit rezervaci")"
                        @onclick="ReserveSeat">
                    Potvrdit rezervaci
                </button>

                <button type="button" class="btn btn-secondary ms-2" @onclick="CancelSelection">
                    Zrušit
                </button>
            </div>
        </div>
    }

    @if (PendingCancelReservation is not null)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var cancelAllowed = PendingCancelReservation.BookDate >= today;
        <div class="mt-4 p-4 bg-light border rounded shadow-sm">
            <div>Vybraná rezervace ke zrušení: @PendingCancelReservation.Seat?.Code</div>

            <h4>Opravdu chcete zrušit svou rezervaci?</h4>

            <p>
                <strong>Místnost:</strong> @PendingCancelReservation.Seat?.Room?.Name<br />
                <strong>Místo:</strong> @PendingCancelReservation.Seat?.Code<br />
                <strong>Datum:</strong> @PendingCancelReservation.BookDate.ToShortDateString()
            </p>

            @if (!cancelAllowed)
            {
                <div class="alert alert-info" role="alert">
                    Zrušení nelze provést zpětně. Lze pouze dnes nebo pro budoucí datum.
                </div>
            }

            <div class="mt-2">
                <button type="button" class="btn btn-danger"
                        disabled="@( !cancelAllowed )"
                        title="@(cancelAllowed ? "Zrušit rezervaci" : "Zrušení zpětně není povoleno")"
                        @onclick="ConfirmCancelReservation">
                    Zrušit rezervaci
                </button>

                <button type="button" class="btn btn-secondary ms-2" @onclick="DismissCancelReservation">
                    Ne, ponechat
                </button>
            </div>
        </div>
    }
}

@code {
    List<Room>? Rooms;
    List<Reservation> Reservations = new();
    Seat? SelectedSeat;

    Reservation? PendingCancelReservation;

    string? ErrorMessage;

    private DateTime _selectedDate = DateTime.Today;
    DateTime SelectedDate
    {
        get => _selectedDate;
        set
        {
            var newDate = value.Date;
            if (_selectedDate == newDate) return;

            _selectedDate = newDate;
            SelectedSeat = null;
            PendingCancelReservation = null;
            ErrorMessage = null;

            _ = InvokeAsync(async () =>
            {
                Reservations = await ReservationRepository.GetByDateAsync(_selectedDate);
                StateHasChanged();
            });
        }
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (!user.Identity?.IsAuthenticated ?? true) return null;
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private bool IsOccupiedByCurrentUser(Seat seat, DateTime date)
    {
        var userId = _cachedUserId;
        if (string.IsNullOrWhiteSpace(userId)) return false;

        var d = DateOnly.FromDateTime(date);
        return Reservations.Any(r => r.SeatId == seat.Id && r.BookDate == d && r.UserId == userId);
    }

    private string GetSeatTitle(Seat seat, bool occupied, bool canCancelOwn, bool isPast)
    {
        if (!occupied)
        {
            return !isPast ? "Kliknutím vyberete místo" : "Nelze rezervovat zpětně";
        }

        if (canCancelOwn)
        {
            return !isPast ? "Kliknutím zrušíte svou rezervaci (dnes nebo budoucí datum)" : "Zrušit nelze zpětně";
        }

        var d = DateOnly.FromDateTime(SelectedDate);
        var res = Reservations.FirstOrDefault(r => r.SeatId == seat.Id && r.BookDate == d);
        if (res is null)
        {
            return "Místo je obsazené";
        }

        // Preferuj e-mail z res.User.Email, fallback na UserId
        var email = res.User?.Email;
        var who = !string.IsNullOrWhiteSpace(email) ? email : res.UserId;

        var createdLocal = res.CreateDate.ToLocalTime();
        var createdStr = createdLocal.ToString("dd.MM.yyyy HH:mm", CultureInfo.CurrentCulture);

        return $"Obsazeno: {who} (rezervováno {createdStr})";
    }

    private async Task OnSeatClick(Seat seat)
    {
        ErrorMessage = null;

        var isPast = SelectedDate.Date < DateTime.Today;

        if (IsSeatOccupied(seat, SelectedDate))
        {
            var userId = await EnsureUserIdAsync();
            if (string.IsNullOrWhiteSpace(userId)) return;

            var d = DateOnly.FromDateTime(SelectedDate);
            var myReservation = Reservations.FirstOrDefault(r =>
                r.SeatId == seat.Id &&
                r.BookDate == d &&
                r.UserId == userId);

            if (myReservation is not null)
            {
                if (isPast)
                {
                    return;
                }

                PendingCancelReservation = myReservation;
                SelectedSeat = null;
                StateHasChanged();
                return;
            }

            return;
        }

        SelectSeat(seat);
    }

    private async Task ConfirmCancelReservation()
    {
        if (PendingCancelReservation is null) return;

        ErrorMessage = null;

        var today = DateOnly.FromDateTime(DateTime.Today);
        if (PendingCancelReservation.BookDate < today)
        {
            return;
        }

        try
        {
            var deleted = await ReservationRepository.DeleteAsync(PendingCancelReservation.Id);
            Reservations = await ReservationRepository.GetByDateAsync(SelectedDate);

            if (deleted)
            {
                PendingCancelReservation = null;
                SelectedSeat = null;
            }
            else
            {
                ErrorMessage = "Rezervaci se nepodařilo zrušit.";
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Zrušení rezervace selhalo: {ex}");
            ErrorMessage = "Zrušení rezervace selhalo.";
        }
    }

    private void DismissCancelReservation()
    {
        PendingCancelReservation = null;
        ErrorMessage = null;
        StateHasChanged();
    }

    private string? _cachedUserId;
    private async Task<string?> EnsureUserIdAsync()
    {
        if (!string.IsNullOrWhiteSpace(_cachedUserId)) return _cachedUserId;
        _cachedUserId = await GetCurrentUserIdAsync();
        return _cachedUserId;
    }

    private void SelectSeat(Seat seat)
    {
        if (IsSeatOccupied(seat, SelectedDate))
            return;

        Console.WriteLine($"SelectSeat called for seat {seat.Id} {seat.Code}");
        SelectedSeat = seat;
        PendingCancelReservation = null;
        ErrorMessage = null;
        StateHasChanged();
    }

    private async Task ReserveSeat()
    {
        try
        {
            ErrorMessage = null;

            if (SelectedSeat is null)
                return;

            var userId = await EnsureUserIdAsync();
            if (string.IsNullOrWhiteSpace(userId))
                return;

            if (IsSeatOccupied(SelectedSeat, SelectedDate))
                return;

            if (SelectedDate.Date < DateTime.Today)
                return;

            var newReservation = new Reservation
            {
                SeatId = SelectedSeat.Id,
                UserId = userId!,
                BookDate = DateOnly.FromDateTime(SelectedDate),
                CreateDate = DateTime.UtcNow
            };

            await ReservationRepository.CreateAsync(newReservation);

            Reservations = await ReservationRepository.GetByDateAsync(SelectedDate);
            SelectedSeat = null;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            ErrorMessage = ex.Message;
            Reservations = await ReservationRepository.GetByDateAsync(SelectedDate);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Rezervace selhala: {ex}");
            ErrorMessage = "Rezervace selhala. Zkuste to prosím znovu.";
            Reservations = await ReservationRepository.GetByDateAsync(SelectedDate);
            StateHasChanged();
        }
    }

    private void CancelSelection() 
    {
        SelectedSeat = null;
        ErrorMessage = null;
    }

    private async Task ReloadReservationsForSelectedDate()
    {
        try
        {
            Reservations = await ReservationRepository.GetByDateAsync(SelectedDate);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Načtení rezervací selhalo: {ex}");
        }
    }

    private bool IsSeatOccupied(Seat seat, DateTime date)
    {
        return Reservations.Any(r =>
            r.SeatId == seat.Id &&
            r.BookDate.ToDateTime(TimeOnly.MinValue).Date == date.Date);
    }

    string GetSeatCss(Seat seat)
    {
        try
        {
            bool isOccupied = IsSeatOccupied(seat, SelectedDate);
            if (isOccupied) return "seat-occupied";
            if (SelectedSeat?.Id == seat.Id) return "seat-selected";
            return "seat-free";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"GetSeatCss error: {ex}");
            return "seat-free";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Rooms = await RoomRepository.GetAllWithSeatsAsync();
            Reservations = await ReservationRepository.GetByDateAsync(SelectedDate);
            _cachedUserId = await GetCurrentUserIdAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Inicializace selhala: {ex}");
        }
    }

    int count;
    void Inc()
    {
        count++;
        Console.WriteLine($"Inc => {count}");
        StateHasChanged();
    }
}

<style>
    .room-container {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .seat-free {
        background: #d1fae5;
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid #10b981;
    }

    .seat-selected {
        background: #93c5fd;
        padding: 10px 20px;
        border-radius: 6px;
        border: 2px solid #2563eb;
        cursor: pointer;
    }

    .seat-occupied {
        background: #fca5a5;
        padding: 10px 20px;
        border-radius: 6px;
        border: 1px solid #ef4444;
        cursor: not-allowed;
    }
</style>